# ── Server ────────────────────────────────────────────────────────────────────
# Port the Ktor server listens on (default: 8080)
SERVER_PORT=8080

# Bind address (default: 0.0.0.0)
SERVER_HOST=0.0.0.0

# Allowed CORS origin — REQUIRED in production
WEBAPP_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kodex

# REQUIRED
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# REQUIRED in production — set a strong random password
# Leave empty for local dev (no auth; acceptable on localhost only)
REDIS_PASSWORD=

# ── MinIO (Avatar Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_AVATARS=avatars
MINIO_PUBLIC_URL=http://localhost:9000

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — minimum 256-bit random secret (never commit the real value)
JWT_SECRET=change_me_to_a_256_bit_secret

# OAuth providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_CALLBACK_BASE_URL=http://localhost:8080

# Cloudflare Turnstile (CAPTCHA)
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Same Turnstile site key, exposed to the webApp frontend bundle by Vite (VITE_ prefix
# required — anything without it is NOT exposed to client code). Must match
# CLOUDFLARE_TURNSTILE_SITE_KEY above. Copy this into app/webApp/.env for local dev.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Email delivery
RESEND_API_KEY=re_your_api_key
SENDGRID_API_KEY=
EMAIL_FROM=noreply@kodex.dev
APP_BASE_URL=http://localhost:5173

# SMS delivery (leave empty to disable provider)
KAVENEGAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# TOTP encryption key — 32 bytes base64 (openssl rand -base64 32)
TOTP_ENCRYPTION_KEY=change_me_to_a_base64_32_byte_key

# WebAuthn challenge cookie encryption key — 32 bytes base64 (openssl rand -base64 32)
WEBAUTHN_CHALLENGE_KEY=change_me_to_a_base64_32_byte_key

# GeoIP database path (see infra/geoip/ in the repo)
GEOIP_DB_PATH=./infra/geoip/GeoLite2-City.mmdb

# ── Sandbox ───────────────────────────────────────────────────────────────────
# REQUIRED in production — shared secret for server ↔ sandbox-runner channel
SANDBOX_SHARED_SECRET=change_me_to_a_random_secret

# ── Logging ───────────────────────────────────────────────────────────────────
# Root log level: TRACE | DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO
